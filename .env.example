# ==========================================
# Personal Platform - Environment Variables
# ==========================================

# 1. Base de Datos (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# 2. Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=assets

# 3. Cloudflare R2 / AWS S3 (Opcional si usas Supabase Storage)
STORAGE_PROVIDER=supabase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# 4. Heavy Worker Service (FFmpeg)
NEXT_PUBLIC_WORKER_URL=http://localhost:8080
WORKER_PORT=8080
